# Copy to .env and fill in real values. .env is gitignored — never commit it.

# OpenAI（或 OpenAI 兼容网关）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
# 自定义网关地址；使用 OpenAI 官方 API 时留空
OPENAI_BASE_URL=

# SMTP (daily digest email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DIGEST_FROM_EMAIL=

# IMAP（Phase 5 反馈收集：轮询发件邮箱中的用户回信标注）
# 缺省回退 SMTP_USER / SMTP_PASSWORD；IMAP_PORT 缺省 993
IMAP_HOST=
# IMAP_PORT=993
# IMAP_USER=
# IMAP_PASSWORD=

# HTTP 五星反馈服务（feedback/server.py，端口 8710）
# FEEDBACK_BASE_URL：接收人设备可访问到本机的地址，如 http://192.168.1.10:8710
# （查本机局域网 IP：ipconfig getifaddr en0）；留空则邮件回退为批量回信标注模式
FEEDBACK_BASE_URL=
# 链接防伪签名密钥：openssl rand -hex 32 生成；缺失时服务拒绝启动并回退回信模式
FEEDBACK_SECRET=
