# Copy to .env and fill in real values. .env is gitignored — never commit it.
#
# GitHub Actions 部署时无需 .env 文件：把下列变量配置为同名 Repository Secrets
# （Settings → Secrets and variables → Actions），workflow 会自动注入同名环境变量。

# OpenAI（或 OpenAI 兼容网关）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
# 自定义网关地址；使用 OpenAI 官方 API 时留空
OPENAI_BASE_URL=

# SMTP (daily digest email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DIGEST_FROM_EMAIL=

# IMAP（Phase 5 反馈收集：轮询发件邮箱中的用户回信标注）
# 缺省回退 SMTP_USER / SMTP_PASSWORD；IMAP_PORT 缺省 993
IMAP_HOST=
# IMAP_PORT=993
# IMAP_USER=
# IMAP_PASSWORD=

# 星标一键反馈（可选）：Cloudflare Worker webhook 直写 feedback_data/pending/，点击即记录
# 两者都配置后卡片 ⭐1-5 走 webhook；留空则降级为 mailto 回信模式（走上面的 IMAP 收集）
# GitHub 部署时配同名 Repository Secrets；FEEDBACK_SECRET 需与 Worker 变量同值（见 README「GitHub 部署」）
FEEDBACK_WEBHOOK_URL=
FEEDBACK_SECRET=
