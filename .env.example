# Copy to .env and fill in real values. .env is gitignored — never commit it.

# OpenAI（或 OpenAI 兼容网关）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
# 自定义网关地址；使用 OpenAI 官方 API 时留空
OPENAI_BASE_URL=

# SMTP (daily digest email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DIGEST_FROM_EMAIL=

# IMAP（Phase 5 反馈收集：轮询发件邮箱中的用户回信标注）
# 缺省回退 SMTP_USER / SMTP_PASSWORD；IMAP_PORT 缺省 993
IMAP_HOST=
# IMAP_PORT=993
# IMAP_USER=
# IMAP_PASSWORD=
