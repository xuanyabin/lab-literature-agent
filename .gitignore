# Virtual environment
.venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Secrets — never commit
.env

# Database
*.db
*.sqlite3

# Logs（全部运行产物；保留 .gitkeep 占位）
logs/*
!logs/.gitkeep

# 会话导出（本地留存，不上传）
kimi-export-session_*.md

# 自动维护的词表缓存（运行时生成，勿手改）
config/users/auto_terms/

# macOS
.DS_Store
*.swp
